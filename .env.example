# Optional anonymous product analytics. Leave blank to ship with no analytics SDK.
# Project tokens are designed for browser use; do not put a PostHog personal API key here.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Optional for self-hosted or reverse-proxied PostHog assets.
VITE_POSTHOG_ASSET_HOST=

# Optional legacy provider. Configure either PostHog or Clarity unless you intentionally need both.
VITE_CLARITY_PROJECT_ID=
